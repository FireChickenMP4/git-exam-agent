# 复制为 .env 并按考场实际值修改。
# docker-compose.example.yml 会把这些变量透传给 examd 与 Gitea。

GITEA_ADMIN_USER=exam-admin
GITEA_ADMIN_PASSWORD=change-me-admin-password
GITEA_ADMIN_TOKEN=
EXAM_WEBHOOK_SECRET=change-me-webhook-secret
EXAM_HOOK_TOKEN=change-me-hook-token
# compose 内部 Gitea 回调 examd 的地址；examd 直接跑在宿主时留空
EXAM_WEBHOOK_URL=http://examd:8080/api/hooks/gitea

# examd 数据目录在宿主机上的绝对路径（compose 同时挂到容器 /app/data）
EXAM_DATA_DIR=/srv/exam/data
# 容器内 judge.work_dir 对应的宿主机路径，供 docker -v 使用
EXAM_HOST_WORK_DIR=/srv/exam/data/judge

# 考场固定 IP
EXAM_PUBLIC_URL=http://10.0.0.10:8080
GITEA_ROOT_URL=http://10.0.0.10:3000/
